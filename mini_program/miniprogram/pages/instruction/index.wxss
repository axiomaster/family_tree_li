
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 88rpx;
  background: #1e293b;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.3);
}

.back-btn {
  position: absolute;
  left: 30rpx;
  bottom: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  color: #fbbf24;
  font-size: 32rpx;
  font-weight: bold;
  z-index: 101;
}

.title {
  color: #fbbf24;
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
